<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="frecuencia_cardiaca.MainPage">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Label Text="Calculadora de Frecuencia Cardiaca" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="Ingrese los latidos detectados en 15 segundos:" FontSize="16" />
        <Entry x:Name="txtLatidos" Placeholder="Ej. 18" Keyboard="Numeric" />
        <Button Text="Calcular" Clicked="OnCalcularClicked" BackgroundColor="#2B0B98" TextColor="White" />
        <Label x:Name="lblResultado" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,20,0,0" />
    </VerticalStackLayout>

</ContentPage>
